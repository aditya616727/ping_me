# Get this from @BotFather in Telegram (send /newbot).
TELEGRAM_BOT_TOKEN=123456789:AA-your-bot-token-here

# Your numeric chat ID. Run:  python get_chat_id.py  to find it.
TELEGRAM_CHAT_ID=123456789

# Optional but recommended once the URL is public: require ?key=THIS on /ping
# so random people who find your URL can't spam your phone. Leave blank to disable.
PING_SECRET=

# Optional: also ring your phone with a Telegram voice call when /ping is hit
# with &call=1. Use your Telegram phone number with country code (for example
# +14155550123) or your @username. First authorize CallMeBot: in Telegram,
# send /start to @CallMeBot_txtbot. Leave blank to disable calls.
CALLMEBOT_USER=

# Port the server listens on.
PORT=8000
